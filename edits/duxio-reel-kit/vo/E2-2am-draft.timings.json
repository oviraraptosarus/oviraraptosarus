  {
   "text": "Apologize twice.",
   "start": 4.788,
   "end": 6.078,
   "e": 0.7
  },
  {
   "text": "And hit send.",
   "start": 6.184,
   "end": 7.019,
   "e": 0.5
  },
  {
   "text": "Now that lead knows",
   "start": 7.4,
