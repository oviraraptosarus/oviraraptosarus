   "e": 0.25
  },
  {
   "text": "will expect it.",
   "start": 11.98,
   "end": 12.99,
   "e": 0.2
  },
  {
   "text": "Instead,",
   "start": 13.792,
   "end": 14.322,
   "e": 0.55
  },
  {
   "text": "write it in your notes.",
   "start": 14.453,
   "end": 15.368,
   "e": 0.6
  },
  {
   "text": "Draft it at night.",
   "start": 15.633,
   "end": 16.583,
   "e": 0.6
  },
  {
   "text": "Send it at seven fifty,",
   "start": 16.813,
   "end": 18.143,
   "e": 0.65
  },
  {
   "text": "before your first client.",
   "start": 18.295,
   "end": 19.58,
   "e": 0.7
  },
  {
   "text": "Same reply.",
   "start": 20.266,
   "end": 21.101,
   "e": 0.7
  },
  {
   "text": "Better words.",
   "start": 21.315,
   "end": 22.085,
   "e": 0.75
  },
  {
   "text": "And they learn when you answer,",
