  {
   "text": "Apologize twice.",
   "start": 5.239,
   "end": 6.419,
   "e": 0.7
  },
  {
   "text": "And hit send.",
   "start": 6.597,
   "end": 7.392,
   "e": 0.5
  },
  {
   "text": "Now that lead knows",
