 "phrases": [
  {
   "text": "It's two oh seven in the morning.",
   "start": 0.06,
   "end": 1.475
  },
  {
   "text": "And you're answering a lead.",
   "start": 1.775,
   "end": 3.085
  },
  {
   "text": "You write four sentences.",
   "start": 3.68,
   "end": 5.035
  },
  {
   "text": "Apologize twice.",
   "start": 5.239,
   "end": 6.419
  },
  {
   "text": "And hit send.",
   "start": 6.597,
   "end": 7.392
  },
  {
   "text": "Now that lead knows",
   "start": 8.025,
   "end": 9.08
  },
  {
   "text": "you answer at two in the morning.",
   "start": 9.151,
   "end": 10.676
  },
  {
   "text": "And some of them",
   "start": 10.992,
   "end": 11.917
  },
  {
   "text": "will expect it.",
   "start": 11.98,
   "end": 12.99
  },
  {
   "text": "Instead,",
   "start": 13.792,
   "end": 14.322
  },
  {
   "text": "write it in your notes.",
   "start": 14.453,
   "end": 15.368
  },
  {
   "text": "Draft it at night.",
   "start": 15.633,
   "end": 16.583
  },
  {
   "text": "Send it at seven fifty,",
   "start": 16.813,
   "end": 18.143
  },
  {
   "text": "before your first client.",
   "start": 18.295,
   "end": 19.58
  },
  {
   "text": "Same reply.",
   "start": 20.266,
   "end": 21.101
  },
  {
   "text": "Better words.",
   "start": 21.315,
   "end": 22.085
  },
  {
   "text": "And they learn when you answer,",
   "start": 22.45,
   "end": 23.795
  },
  {
   "text": "so they wait for it.",
   "start": 23.945,
   "end": 25.13
  },
  {
   "text": "Comment DRAFT,",
   "start": 25.804,
   "end": 26.569
  },
  {
   "text": "and I'll D M you the notes template",
   "start": 26.768,
   "end": 28.388
  },
  {
   "text": "and three morning replies.",
